{
  "name": "daw-plugin-manager",
  "version": "1.0.0",
  "description": "Read-only discovery utility for installed DAWs and audio plugins, with update status reporting",
  "main": "./out/main/index.js",
  "author": "DAW Plugin Manager",
  "license": "MIT",
  "scripts": {
    "dev": "npm run tauri:dev",
    "tauri:ui:dev": "vite --config vite.tauri.config.ts",
    "tauri:ui:build": "vite build --config vite.tauri.config.ts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "dist:mac": "npm run tauri:build",
    "build": "npm run tauri:ui:build",
    "scan:cli": "tsx scripts/scan-cli.ts",
    "test:contracts": "tsx scripts/test-catalog-contracts.ts && tsx scripts/test-catalog-feed-v2.ts",
    "test:feed": "tsx scripts/test-catalog-feed-v2.ts",
    "test:matcher": "tsx scripts/test-matcher-rules.ts",
    "test:golden": "tsx scripts/golden-scan-check.ts --with-previous",
    "test": "npm run test:contracts && npm run test:matcher && npm run test:golden",
    "scan:snapshot": "tsx scripts/capture-scan-snapshot.ts",
    "catalog:validate": "tsx scripts/validate-catalog.ts",
    "catalog:refresh": "tsx scripts/catalog/refresh.ts",
    "catalog:gaps": "node scripts/catalog/build-gap-queue.js",
    "catalog:sticky-reverify": "node scripts/catalog/sticky-reverify.js",
    "catalog:flash-extract": "node scripts/catalog/flash-extract.js",
    "catalog:antigravity-scrub": "node scripts/catalog/antigravity-scrub.js",
    "catalog:smart-scrub": "node scripts/catalog/smart-scrub.js",
    "catalog:install-weekly": "bash scripts/catalog/install-weekly-launchd.sh",
    "catalog:sync-remote-urls": "bash scripts/sync-remote-urls.sh",
    "electron:dev": "bash scripts/brand-electron-dev.sh && env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "electron:build": "electron-vite build",
    "electron:preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "electron:fetch": "node scripts/fetch-electron.js && bash scripts/brand-electron-dev.sh",
    "electron:dist": "npm run electron:build && env -u ELECTRON_RUN_AS_NODE electron-builder --mac"
  },
  "build": {
    "appId": "com.dawpluginmanager.app",
    "productName": "DAW Plugin Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "catalog/catalog.json",
      "catalog/remote-urls.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "catalog/catalog.json",
        "to": "catalog/catalog.json"
      },
      {
        "from": "catalog/remote-urls.json",
        "to": "catalog/remote-urls.json"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "dir"
      ]
    }
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-http": "^2.6.1",
    "plist": "^3.1.0",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.0",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^22.10.0",
    "@types/plist": "^3.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/semver": "^7.5.8",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
